  "narrative": {
    "northStar": "A cinematic editorial film programme",
    "overview": "An independent entertainment collection with expressive typography, generous dark space and deliberate transitions between encounters. GlassPlay remains season-neutral; each experience can carry its own atmosphere. The confirmed mint identity and Nevermore's spectral lavender define the current implementation.\n\nThe system uses authored artwork, simple controls and restrained motion. Annapurna Interactive's selection hierarchy and Playdead's restraint informed the review benchmark; neither is a copied visual style. Page-specific composition remains in [the surface brief](docs/PRODUCT-SURFACE.md).",
    "keyCharacteristics": [
      "Expressive serif display type with readable sans-serif support.",
      "Mint collection identity and a distinct lavender Nevermore theme.",
      "Arched featured artwork, fine dividers and open editorial sections.",
      "Visible native controls and intentional media states."
    ],
    "rules": [
      {
        "name": "The Experience Palette Rule",
        "body": "Keep the collection mint identity distinct from each experience's palette; Nevermore's lavender does not recolor the collection.",
        "section": "colors"
      },
      {
        "name": "The Display and Reading Rule",
        "body": "Use Newsreader for expressive headings and Manrope for instructions, navigation and sustained reading.",
        "section": "typography"
      },
      {
        "name": "The Readable Artwork Rule",
        "body": "Compose and shade imagery to support readable copy; retain visible artwork rather than hiding it behind decoration.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the distinction between collection and experience palettes.",
      "**Do** keep the mobile reading order, visible navigation and keyboard focus.",
      "**Do** show authentic media only within its approved publication boundary, with Simulator labels and text alternatives.",
      "**Do** use title artwork and explicit availability copy when publication is held.",
      "**Do** respect reduced motion and require intentional media playback."
    ],
    "donts": [
      "**Don't** turn collection pages permanently Halloween-themed.",
      "**Don't** substitute emoji, glyph icons or stock imagery for the authored visual system.",
      "**Don't** place decorative eyebrows above headings or invent play and download actions.",
      "**Don't** imply verified physical-device behavior through artwork or Simulator footage."
    ]
  }
