---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import MediaPlayer from '../components/MediaPlayer.astro';
import {nevermore, concepts, hasMedia, url, media} from '../lib/catalogue';
---
<Layout title="GlassPlay — Interactive Experiences for AR Smart Glasses" description="A little magic, right before your eyes. Discover seasonal interactive experiences for AR smart glasses, beginning with Nevermore, a Halloween haunting.">
  <section class="home-hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">A little magic,<br /><em>right before<br />your eyes.</em></h1>
      <p class="hero-summary">Interactive experiences for AR smart glasses.<br class="desktop-break" /> Small encounters that make the everyday feel extraordinary.</p>
      <a class="button" href={url(nevermore.page!)}>Discover {nevermore.name}<Arrow /></a>
      <p class="hero-footnote">Your world stays in view. Something new steps into it.</p>
    </div>
    <a class="feature-poster" href={url(nevermore.page!)} aria-label="Discover Nevermore, the Halloween experience">
      <div class="poster-window">
        <img src={hasMedia ? media('raven.webp') : url(nevermore.cover)} srcset={hasMedia ? `${media('raven-small.webp')} 480w, ${media('raven.webp')} 960w` : undefined} sizes="(max-width: 760px) 90vw, 45vw" alt={hasMedia ? 'The Azure Night raven approaches with its wings spread, in an approved production-animation frame.' : 'Nevermore title artwork with a crescent and a doorway into darkness.'} width={hasMedia ? '960' : '1200'} height={hasMedia ? '720' : '630'} fetchpriority="high" />
        <span class="poster-status">{nevermore.status} in preparation</span>
      </div>
      <div class="poster-caption"><div><h2>{nevermore.name}</h2><p class="small-copy">{nevermore.theme} · {nevermore.category}</p></div><span class="round-arrow"><Arrow /></span></div>
      <p>Halloween comes looking for you.</p>
    </a>
  </section>

  <section class="experience-section wrap" id="experiences" aria-labelledby="experience-heading">
    <div class="section-intro"><h2 id="experience-heading">A different kind<br />of <em>presence.</em></h2><div><p>{nevermore.summary}</p><a class="text-link" href={url(nevermore.page!)}>Step into Nevermore <Arrow /></a></div></div>
    <MediaPlayer teaser />
    <div class="experience-note"><span>Halloween for AR smart glasses</span><span>Windows / Simulator preview · Physical Prism testing pending</span></div>
  </section>

  <section class="seasons-section wrap" aria-labelledby="seasons-heading">
    <div class="section-intro"><h2 id="seasons-heading">More seasons.<br /><em>More possibilities.</em></h2><p>New worlds are taking shape. These are future concepts, with a little room left for surprise.</p></div>
    <div class="season-grid">
      {concepts.map(item => <article class="season"><img src={url(item.cover)} width="600" height="440" alt="" loading="lazy" /><div class="season-info"><h3>{item.name}</h3><span class="small-label">Coming soon · Concept</span><p>{item.summary}</p></div></article>)}
    </div>
  </section>

  <section class="about-section wrap" id="about" aria-labelledby="about-heading">
    <div class="about-mark" aria-hidden="true"><span></span><span></span></div>
    <div><h2 id="about-heading">Keep your eyes<br />on <em>your world.</em></h2><p>GlassPlay is an independent collection of interactive experiences for augmented-reality smart glasses. Moments of curiosity, wonder and a little mischief, made to share the space you're already in.</p><p>We begin with Nevermore. Each experience has its own character, its own season, and a clear account of where it has been tested.</p><a class="text-link" href={url('experiences/nevermore/#availability')}>Explore the first preview <Arrow /></a></div>
  </section>
</Layout>
