---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import MediaPlayer from '../components/MediaPlayer.astro';
import {nevermore, concepts, url} from '../lib/catalogue';
---
<Layout title="GlassPlay — Interactive Experiences for AR Smart Glasses" description="A little magic, right before your eyes. Discover seasonal interactive experiences for AR smart glasses, beginning with Nevermore, a Halloween haunting.">
  <section class="home-hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">A little magic,<br /><span>right before<br />your eyes.</span></h1>
      <p class="hero-summary"><strong>Interactive experiences for AR smart glasses.</strong> Small encounters that make the everyday feel extraordinary.</p>
      <a class="button" href={url(nevermore.page!)}>Discover {nevermore.name}<Arrow /></a>
      <p class="hero-footnote">Your world stays in view. Something new steps into it.</p>
    </div>
    <figure class="glasses-art">
      <img src={url('brand/glassplay-hero.webp')} srcset={`${url('brand/glassplay-hero-small.webp')} 800w, ${url('brand/glassplay-hero.webp')} 1600w`} sizes="(max-width:760px) 100vw, 56vw" alt="An original 3D illustration of smart glasses, with violet and blue light reflected through their lenses." width="1600" height="1100" fetchpriority="high" />
    </figure>
  </section>
  <section class="experience-section wrap" id="experiences" aria-labelledby="experience-heading">
    <div class="section-intro"><div><h2 id="experience-heading">Nevermore</h2><p class="experience-tagline">Halloween comes looking for you.</p></div><div><p>{nevermore.summary}</p><a class="text-link" href={url(nevermore.page!)}>Step into Nevermore <Arrow /></a></div></div>
    <MediaPlayer teaser />
    <div class="experience-note"><span>Halloween for AR smart glasses</span><span>Windows / Simulator preview</span></div>
  </section>
  <section class="seasons-section wrap" aria-labelledby="seasons-heading">
    <div class="section-intro"><h2 id="seasons-heading">A world for<br /><span>every season.</span></h2><p>New worlds are taking shape. These are future concepts, with a little room left for surprise.</p></div>
    <div class="season-grid">
      {concepts.map(item => <article class="season"><div class="season-info"><h3>{item.name}</h3><span class="small-label">Coming soon · Concept</span><p>{item.summary}</p></div></article>)}
    </div>
  </section>
  <section class="about-section wrap" id="about" aria-labelledby="about-heading">
    <h2 id="about-heading">Made for the world<br /><span>in front of you.</span></h2>
    <div><p>GlassPlay is an independent collection of interactive experiences for augmented-reality smart glasses. Moments of curiosity, wonder and a little mischief, made to share the space you're already in.</p><p>We begin with Nevermore. Each experience has its own character, its own season, and a clear account of where it has been tested.</p><div class="about-links"><a class="text-link" href={url(nevermore.page!)}>Explore the first preview <Arrow /></a><a class="text-link" href="https://github.com/RBraga01">Meet the creator <Arrow /></a></div></div>
  </section>
</Layout>
