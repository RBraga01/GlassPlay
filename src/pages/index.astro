---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import MediaPlayer from '../components/MediaPlayer.astro';
import {nevermore, concepts, url} from '../lib/catalogue';
// Season concept art: the catalogue cover is the 1200w variant; siblings share its name.
const art = (cover: string, variant: string) => url(cover.replace(/-1200\.webp$/, `-${variant}.webp`));
const mobileSet = (cover: string) => `${art(cover, 'mobile-660')} 660w, ${art(cover, 'mobile-1000')} 1000w`;
const desktopSet = (cover: string) => `${art(cover, '800')} 800w, ${url(cover)} 1200w, ${art(cover, '1672')} 1672w`;
const desktopSizes = '(max-width: 1100px) calc(100vw - 64px), min(1328px, calc(100vw - 112px))';
const placeholder = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
const seasonAlt: Record<string, string> = {
  christmas: 'Concept art: smart glasses on a snowy windowsill at night, with a tiny leaping reindeer, a snowman holding a lantern, an opening gift and a shooting star.',
  easter: 'Concept art: smart glasses on a garden table at sunset, with a curious bunny peeking over them, glowing butterflies, a blooming flower and a cracked painted egg.',
  'st-patricks': 'Concept art: smart glasses on a wooden table by a rainy window, with a little sprite running off with a coin, a rainbow, four-leaf clovers and a pot of gold.',
};
---
<Layout title="GlassPlay — Interactive Experiences for AR Smart Glasses" description="A little magic, right before your eyes. Discover seasonal interactive experiences for AR smart glasses, beginning with Nevermore, a Halloween haunting.">
  <section class="home-hero" aria-labelledby="hero-title">
    <picture class="hero-art">
      <source media="(max-width: 760px)" srcset={`${url('brand/glassplay-hero-mobile-560.webp')} 560w, ${url('brand/glassplay-hero-mobile-840.webp')} 840w, ${url('brand/glassplay-hero-mobile-1100.webp')} 1100w`} sizes="100vw" width="1100" height="783" />
      <img src={url('brand/glassplay-hero-1200.webp')} srcset={`${url('brand/glassplay-hero-800.webp')} 800w, ${url('brand/glassplay-hero-1200.webp')} 1200w, ${url('brand/glassplay-hero-1672.webp')} 1672w`} sizes="100vw" width="1672" height="941" fetchpriority="high" alt="Illustration: a pair of smart glasses on a desk at dusk, surrounded by small magical encounters: a glowing raven and feather, a friendly ghost, a jack-o'-lantern, a tiny lantern-bearer, a star, a target and a floating island with a four-leaf clover." />
    </picture>
    <div class="hero-copy wrap">
      <h1 id="hero-title"><span class="wordmark">Glass<span>Play</span></span> <span class="hero-tagline">A little magic, right before your eyes.</span></h1>
      <p class="hero-kicker">The playful side of smart glasses.</p>
      <p class="hero-summary">Small experiences and mini-games that turn everyday moments into something unexpected.</p>
      <a class="button" href={url(nevermore.page!)}>Discover {nevermore.name}<Arrow /></a>
    </div>
  </section>
  <section class="experience-section wrap" id="experiences" aria-labelledby="experience-heading">
    <div class="section-intro"><div><h2 id="experience-heading">Nevermore</h2><p class="experience-tagline">Halloween comes looking for you.</p></div><div><p>{nevermore.summary}</p><a class="text-link" href={url(nevermore.page!)}>Step into Nevermore <Arrow /></a></div></div>
    <MediaPlayer teaser />
    <div class="experience-note"><span>Halloween for AR smart glasses · SOFT and HAUNTED</span><span>Version {nevermore.candidate!.version} · Download for Windows / Raven Simulator</span></div>
  </section>
  <section class="seasons-section wrap" aria-labelledby="seasons-heading">
    <div class="section-intro"><h2 id="seasons-heading">A world for<br /><span>every season.</span></h2><p>New worlds are taking shape. These are future concepts, with a little room left for surprise.</p></div>
    {/* Without JavaScript the deferred art is hidden and the <noscript> art is shown instead. */}
    <noscript><style is:inline>.season-art[data-deferred]{display:none}</style></noscript>
    <div class="season-list">
      {concepts.map(item => (
        <article class="season season-banner">
          {/* Deferred until the page has loaded, so the banners never compete with the hero (LCP). */}
          <picture class="season-art" data-deferred>
            <source media="(max-width: 760px)" data-srcset={mobileSet(item.cover)} sizes="calc(100vw - 40px)" width="1112" height="780" />
            <img src={placeholder} data-srcset={desktopSet(item.cover)} sizes={desktopSizes} width="1672" height="941" loading="lazy" decoding="async" alt={seasonAlt[item.id]} />
          </picture>
          <noscript><picture class="season-art">
            <source media="(max-width: 760px)" srcset={mobileSet(item.cover)} sizes="calc(100vw - 40px)" width="1112" height="780" />
            <img src={url(item.cover)} srcset={desktopSet(item.cover)} sizes={desktopSizes} width="1672" height="941" loading="lazy" decoding="async" alt={seasonAlt[item.id]} />
          </picture></noscript>
          <div class="season-info"><h3>{item.name}</h3><span class="small-label">Coming soon · Concept</span><p>{item.summary}</p></div>
        </article>
      ))}
    </div>
  </section>
  <section class="about-section wrap" id="about" aria-labelledby="about-heading">
    <h2 id="about-heading">Made for the world<br /><span>in front of you.</span></h2>
    <div><p>GlassPlay is an independent collection of interactive experiences for augmented-reality smart glasses. Moments of curiosity, wonder and a little mischief, made to share the space you're already in.</p><p>We begin with Nevermore. Each experience has its own character, its own season, and a clear account of where it has been tested.</p><div class="about-links"><a class="text-link" href={url(nevermore.page!)}>Explore Nevermore <Arrow /></a><a class="text-link" href="https://github.com/RBraga01">Meet the creator <Arrow /></a></div></div>
  </section>
</Layout>
<script>
  // Season art waits until the page has loaded and painted the next frame (so the hero,
  // the LCP, is already on screen); loading="lazy" still applies afterwards.
  const reveal = () => document.querySelectorAll<HTMLImageElement | HTMLSourceElement>('[data-deferred] [data-srcset]').forEach(el => {
    el.srcset = el.dataset.srcset!;
    delete el.dataset.srcset;
  });
  const afterPaint = () => requestAnimationFrame(() => requestAnimationFrame(reveal));
  if (document.readyState === 'complete') afterPaint(); else addEventListener('load', afterPaint, { once: true });
  // Never hold the banners back for long: one slow resource must not keep them blank.
  setTimeout(reveal, 2500);
</script>
