---
import '../styles/fonts.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { url, canonical, review } from '../lib/catalogue';
interface Props {title: string; description: string; path?: string; theme?: string; social?: string; noindex?: boolean;}
const {title, description, path='', theme='', social='brand/glassplay-social.png', noindex=false}=Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a111d" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={review || noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical(path)} />
    <link rel="icon" type="image/png" href={url('brand/favicon.png')} />
    <link rel="apple-touch-icon" href={url('brand/apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GlassPlay" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical(path)} />
    <meta property="og:image" content={canonical(social)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={theme==='nevermore' ? 'Nevermore. Halloween comes looking for you. GlassPlay title artwork.' : 'GlassPlay. A little magic, right before your eyes. Interactive experiences for AR smart glasses.'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={canonical(social)} />
    <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebSite',name:'GlassPlay',url:canonical(),description:'Interactive Experiences for AR Smart Glasses',inLanguage:'en'})} />
  </head>
  <body class={theme}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="brand" href={url()} aria-label="GlassPlay home"><Logo /><span>GlassPlay</span></a>
      <nav aria-label="Main navigation">
        <a href={url('#experiences')}>Experiences</a>
        <a href={url('#about')}>About</a>
      </nav>
      <span class="header-note">Made for a different point of view.</span>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer wrap">
      <div><a class="brand" href={url()}><Logo /><span>GlassPlay</span></a><p>A little magic, right before your eyes.</p></div>
      <nav aria-label="Footer navigation"><a href={url('credits/')}>Credits & privacy</a><a href="https://github.com/RBraga01">Creator profile</a><a href={url('#about')}>About</a></nav>
      <p class="footer-fine">Independent experiences. Device support is verified per experience.</p>
    </footer>
  </body>
</html>
